[Unit]
Description=MTGC lakehouse chain: land upstream into raw/ ({{INSTANCE}})
After=network-online.target
Wants=network-online.target
OnFailure=mtgc-alert-{{INSTANCE}}@%n.service

[Service]
MemoryMax=6G
MemorySwapMax=0
Nice=15
IOSchedulingClass=idle
CPUWeight=20
Type=oneshot
ExecStartPre=/bin/mkdir -p %h/.local/share/mtgc-lake/{{INSTANCE}}/raw
# Writes no catalogue byte: every fetch is teed verbatim into the raw landing zone.
ExecStart=podman run --rm --memory 6g --memory-swap 6g --env-file %h/.config/mtgc/{{INSTANCE}}.env --env-file %h/.config/mtgc/{{INSTANCE}}/lake.env -e MTGC_HOME=/data -v mtgc-{{INSTANCE}}-data:/data:Z -e MTGC_LAKE_RAW_DIR=/lake/raw -v %h/.local/share/mtgc-lake/{{INSTANCE}}/raw:/lake/raw:Z --entrypoint mtg localhost/mtgc:{{INSTANCE}} data land
ExecStart=podman run --rm --memory 6g --memory-swap 6g --env-file %h/.config/mtgc/{{INSTANCE}}.env --env-file %h/.config/mtgc/{{INSTANCE}}/lake.env -e MTGC_HOME=/data -v mtgc-{{INSTANCE}}-data:/data:Z -e MTGC_LAKE_RAW_DIR=/lake/raw -v %h/.local/share/mtgc-lake/{{INSTANCE}}/raw:/lake/raw:Z --entrypoint mtg localhost/mtgc:{{INSTANCE}} data fetch-edhrec
# Raw bytes reach the lake bucket under role/mtgc-lake; append-only, no --delete.
ExecStartPost=/bin/sh -c 'exec bash {{REPO_DIR}}/deploy/lake-sync.sh {{INSTANCE}} raw'
TimeoutStartSec=10800
