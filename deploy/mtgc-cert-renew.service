[Unit]
Description=MTGC TLS certificate renewal ({{INSTANCE}})

# SAMPLE. setup.sh does not install this — renewal is the operator's job, and
# the app only ever reads certificates. Copy it, substitute the instance name,
# edit the hostname below, and install it yourself. See deploy/README.md ->
# "Trusted certificates" for the one-time steps this unit assumes.

[Service]
Type=oneshot
# Recipe 1 (tailscale cert). Overwrites cert.pem/key.pem in place; Let's Encrypt
# certificates expire in 90 days and tailscaled does not track files it wrote to
# a path you chose, so nothing renews them but this.
ExecStart=/usr/bin/tailscale cert --cert-file %h/.config/mtgc/certs/cert.pem --key-file %h/.config/mtgc/certs/key.pem MACHINE.TAILNET.ts.net
# The certificate is read once, at startup, by ssl.SSLContext.load_cert_chain.
# New files on disk change nothing until the container restarts.
ExecStart=/usr/bin/systemctl --user restart mtgc-{{INSTANCE}}
TimeoutStartSec=900
