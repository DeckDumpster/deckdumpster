{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CatalogZoneObjectsAppendOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::{{BUCKET}}/raw/*", "arn:aws:s3:::{{BUCKET}}/lake/*"]
    },
    {
      "Sid": "CatalogZoneListingIsPrefixScoped",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {"StringLike": {"s3:prefix": ["raw/*", "lake/*"]}}
    },
    {
      "Sid": "DenyTheTenantZoneEvenIfSomethingElseAllowsIt",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::{{BUCKET}}/tenant/*"
    },
    {
      "Sid": "DenyListingTheTenantZone",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {"StringLike": {"s3:prefix": "tenant/*"}}
    },
    {
      "Sid": "DenyTheBackupBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::{{BACKUP_BUCKET}}", "arn:aws:s3:::{{BACKUP_BUCKET}}/*",
        "arn:aws:s3:::{{LITESTREAM_BUCKET}}", "arn:aws:s3:::{{LITESTREAM_BUCKET}}/*"
      ]
    },
    {
      "Sid": "DenyRewritingTheGovernanceItself",
      "Effect": "Deny",
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::{{BUCKET}}"
    }
  ]
}
