[Unit]
Description=MTGC lakehouse chain: value every tenant's history from the zone ({{INSTANCE}})
After=network-online.target mtgc-ship-{{INSTANCE}}.service
Wants=network-online.target
OnFailure=mtgc-alert-{{INSTANCE}}@%n.service

[Service]
Type=oneshot
ExecStart=podman run --rm --env-file %h/.config/mtgc/{{INSTANCE}}.env --env-file %h/.config/mtgc/{{INSTANCE}}/lake.env -e MTGC_HOME=/data -v mtgc-{{INSTANCE}}-data:/data:Z -e AWS_PROFILE=mtgc-tenant -v %h/.aws:/root/.aws:ro,Z -e MTGC_LAKE_MASTER_KEY_FILE=/run/mtgc/tenant-master.key -v %h/.config/mtgc/{{INSTANCE}}/tenant-master.key:/run/mtgc/tenant-master.key:ro,Z -e MTGC_LAKE_CATALOG=/lake/iceberg-catalog.sqlite -e MTGC_LAKE_WAREHOUSE=/lake/warehouse -v %h/.local/share/mtgc-lake/{{INSTANCE}}/iceberg:/lake:Z localhost/mtgc:{{INSTANCE}} mtg lake value
TimeoutStartSec=3600
